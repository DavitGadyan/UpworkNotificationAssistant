# /etc/gw.env (chmod 600, owner root) - read by gw.service
UPWORK_CLIENT_ID=            # from the approved API key
UPWORK_CLIENT_SECRET=
UPWORK_TENANT_ID=            # optional: your freelancer org id (X-Upwork-API-TenantId)
PUBLIC_URL=https://gw.s1mpleai.org
GATEWAY_TOKEN=               # openssl rand -hex 32  - the app sends this as Bearer (UPWORK_GATEWAY_TOKEN in the app's .env)
GATEWAY_ADMIN_TOKEN=         # openssl rand -hex 32  - you type this once on /oauth/start
TOKEN_ENC_KEY=               # openssl rand -hex 32  - encrypts the Upwork tokens on disk
DATA_DIR=/var/lib/gw
PORT=8787
PER_MINUTE=250
DAILY_CAP=5000
