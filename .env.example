# --- Where the app lives. OAuth callbacks: $PUBLIC_BASE_URL/api/mcp/callback (MCP) and /api/auth/callback (API key) ---
PUBLIC_BASE_URL=https://jobs.s1mpleai.org
NEXT_PUBLIC_APP_NAME=Pulse Assistant      # neutral brand: never put "Upwork" in the app name or hostname
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me              # basic auth for the whole dashboard (required when public)
TOKEN_ENC_KEY=                            # any long random string; encrypts OAuth tokens at rest
DEFAULT_TIMEZONE=Asia/Yerevan

# --- Supabase (database for the web app, worker and mobile app) ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...     # client-safe; also used by the Expo app
SUPABASE_SECRET_KEY=sb_secret_...               # server only (admin / push)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
OWNER_EMAIL=you@example.com                     # the only account the mobile app can sign in with

# --- Upwork MCP connector (primary data source; no key needed, log in from Settings → Connect Upwork) ---
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_ORG_UID=                           # optional; empty = your freelancer (TALENT) account from list_accounts

# --- Claude API (JobRankingAssistant, ProposalDraftAssistant, Closer, ProfileCoach) ---
ANTHROPIC_API_KEY=

# --- Marketplace GraphQL API key (optional fallback, after Upwork approves the key) ---
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_TENANT_ID=

# --- Telegram: bot must be an ADMIN of the channel with "Post messages" + "Edit messages of others" ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                         # channel id, e.g. -100…; find it via GET /api/telegram/discover or getChat?chat_id=@name
TELEGRAM_WEBHOOK_SECRET=                  # random string; protects the 👍/👎/Dismiss button webhook

# --- Retell (optional outbound call to your own phone for top jobs) ---
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=+1...
RETELL_TO_NUMBER=+374...

# --- Local only ---
DEMO_MODE=0                               # 1 = fixture jobs stand in until Upwork is connected
NEXT_PUBLIC_THEME=neutral
